{
  "name": "capiremo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "predev": "node scripts/copy-ort.mjs",
    "dev": "vite --host",
    "dev:https": "vite --host --mode https",
    "prebuild": "node scripts/copy-ort.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && node --test --test-concurrency=1 e2e/flow.test.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
